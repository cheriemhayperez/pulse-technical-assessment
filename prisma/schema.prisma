// Pulse — coordination store only. Nothing here is durable user data:
// rows are deleted on leave, on staleness, or after a signal is delivered.
// Chat text and video are NOT modeled — they ride WebRTC peer-to-peer and
// never reach the server.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Presence {
  id          String   @id // public peer id shown on the map
  secretHash  String   @unique // hash of the private session secret
  lat         Float // privacy-offset coords (raw GPS is never stored)
  lng         Float
  busy        Boolean  @default(false) // true while in an active connection
  pendingWith String? // other public id during request or connection
  intent      String? // optional allowlisted purpose for this session only
  ask         String? // optional short ask, capped so map badges stay one line
  lastSeen    DateTime

  @@index([lastSeen])
}

model Signal {
  // Mailbox for connection requests + WebRTC signaling only.
  id        String   @id @default(uuid())
  toId      String // recipient session id
  fromId    String // sender session id
  type      String // request | accept | decline | offer | answer | ice | end
  payload   String? // JSON string (SDP / ICE candidate)
  createdAt DateTime @default(now())

  @@index([toId])
}
